{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true,
    "resolveJsonModule": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "lib", "tests", "vite.config.ts", "supabase/functions/s21-api/service.ts", "supabase/functions/s21-api/database.ts"]
}
